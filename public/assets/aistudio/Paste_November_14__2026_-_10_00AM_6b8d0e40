                              <DishIllustration art={item.dishArt} className="w-full h-28" />
                              {rIdx === 0 && (
                                <span className="absolute top-2 left-2 bg-[#E7EFE1]/95 text-[#2E531A] text-[11px] font-extrabold px-2.5 py-0.5 rounded-full flex items-center gap-0.5 shadow-2xs">
                                  <Sparkles className="w-3 h-3" /> AI 추천
                                </span>
                              )}
                              <button
                                onClick={(e) => {
                                  e.stopPropagation();
                                  toggleWishlist(item.id);
                                }}
                                className="absolute top-2 right-2 w-7 h-7 rounded-full bg-white/95 flex items-center justify-center shadow-2xs"
                                aria-label="찜하기"
                              >
                                <Heart
                                  className={`w-4 h-4 ${
                                    wished ? 'fill-red-500 text-red-500' : 'text-gray-500'
                                  }`}
                                />
                              </button>
                            </div>
                            <button
                              onClick={() => openMenuDetail(item.id)}
                              className="mt-2.5 text-left font-extrabold text-[15px] text-[#141812] line-clamp-1 hover:underline"
                            >
                              {item.name}
                            </button>
                            <div className="flex items-center gap-1 text-xs text-[#4A5246] mt-1">
                              <Star className="w-3.5 h-3.5 fill-[#2E531A] text-[#2E531A]" />
                              <span className="font-bold text-[#141812]">{item.rating}</span>
                              <span>({item.reviewCount.toLocaleString()})</span>
                              <span>· {item.deliveryMinutes}분</span>
                            </div>
                          </div>
                          <button
                            onClick={() => {
                              setChatMessages((prev) =>
                                prev.map((m) =>
                                  m.id === msg.id
                                    ? { ...m, quickOrderMenuId: item.id, quickOrderQty: 1 }
                                    : m
                                )
                              );
                              showToast(`${item.name}을(를) 바로 결제 카드에 담았어요.`);
                            }}
                            className="mt-3 w-full py-2 rounded-xl bg-[#E7EFE1] hover:bg-[#D6E4CC] text-[#2E531A] font-extrabold text-[13px] transition"
                          >
                            담기
                          </button>
                        </div>
                      );
                    })}
                  </div>
                )}

                {/* AI 원스톱 바로 결제 카드 */}
                {quickMenu && (
                  <div className="space-y-2.5 pt-1">
                    <div className="flex items-center gap-2.5">
                      <AlleRobotMascot size="sm" />
                      <div className="bg-white px-4 py-3 rounded-2xl rounded-tl-sm shadow-sm border border-black/5 text-[15px] font-semibold text-[#141812]">
                        {quickMenu.name}을 주문할까요?
                      </div>
                    </div>

                    <div className="bg-white rounded-2xl p-4 shadow-sm border border-black/5 space-y-3.5">
                      <div className="flex items-center justify-between gap-2">
                        <div className="flex items-center gap-3">
                          <div className="w-14 h-14 rounded-xl overflow-hidden shrink-0">
                            <DishIllustration art={quickMenu.dishArt} className="w-full h-full" />
                          </div>
                          <div>
                            <div className="font-extrabold text-[15px] text-[#141812]">
                              {quickMenu.name} {currentQty}개
                            </div>
                            <div className="text-[13px] text-[#4A5246] mt-0.5">
                              {formatKRW(quickMenu.price)} · 배달 {quickMenu.deliveryMinutes}분
                            </div>
                          </div>
                        </div>

                        {/* 수량 조절 (양의 정수 검증) */}
                        <div className="flex items-center gap-2.5 bg-[#F6F7F4] rounded-full px-2.5 py-1.5 border border-black/5">
                          <button
                            onClick={() =>
                              setChatMessages((prev) =>
                                prev.map((m) =>
                                  m.id === msg.id
                                    ? {
                                        ...m,
                                        quickOrderQty: sanitizeQuantity(currentQty - 1),
                                      }
                                    : m
                                )
                              )
                            }
                            className="w-7 h-7 rounded-full bg-white flex items-center justify-center text-[#141812] shadow-2xs"
                            aria-label="수량 감소"
                          >
                            <Minus className="w-3.5 h-3.5" />
                          </button>
                          <span className="text-sm font-extrabold w-4 text-center">{currentQty}</span>
                          <button
                            onClick={() =>
                              setChatMessages((prev) =>
                                prev.map((m) =>
                                  m.id === msg.id
                                    ? {
                                        ...m,
                                        quickOrderQty: sanitizeQuantity(currentQty + 1),
                                      }
                                    : m
                                )
                              )
                            }
                            className="w-7 h-7 rounded-full bg-white flex items-center justify-center text-[#141812] shadow-2xs"
                            aria-label="수량 증가"
                          >
                            <Plus className="w-3.5 h-3.5" />
                          </button>
                        </div>
                      </div>

                      <div className="flex items-center justify-between pt-2.5 border-t border-gray-100">
                        <span className="text-[13px] text-[#4A5246] font-semibold">총 결제금액</span>
                        <span className="text-xl font-extrabold text-[#141812]">
                          {formatKRW(quickMenu.price * currentQty)}
                        </span>
                      </div>

                      <div className="grid grid-cols-2 gap-2.5">
                        <button
                          onClick={() => openMenuDetail(quickMenu.id)}
                          className="py-3 rounded-xl bg-[#F2F4EE] hover:bg-[#E5EAE0] text-[#2E531A] font-extrabold text-sm transition"
                        >
                          다른 메뉴 보기
                        </button>
                        <button
                          onClick={() =>
                            triggerOrderConfirmation({
                              menu: quickMenu,
                              optionName: quickMenu.options[0]?.name || '기본',
                              unitPrice: quickMenu.price,
                              quantity: currentQty,
                              deliveryFee: quickMenu.deliveryFee,
                              deliveryMode: '이웃 도보 (Track 1)',
                            })
                          }
                          className="py-3 rounded-xl bg-[#2E531A] hover:bg-[#234113] text-white font-extrabold text-sm flex items-center justify-center gap-1.5 shadow-sm transition"
                        >
                          <Zap className="w-4 h-4 fill-current" /> 바로 결제하기
                        </button>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>

        {/* 하단 자연어 입력 & 음성 시뮬레이션 바 */}
        <div className="p-3.5 bg-white border-t border-black/5">
          <form
            onSubmit={(e) => {
              e.preventDefault();
              handleSendChat();
            }}
            className="flex items-center gap-2.5"
          >
            <input
              type="text"
              value={chatInput}
              onChange={(e) => setChatInput(e.target.value)}
              placeholder="또는 원하는 메뉴를 직접 입력하세요"
              className="flex-1 bg-[#F3F5F0] text-[15px] px-4 py-3 rounded-full outline-none focus:ring-2 focus:ring-[#2E531A]"
            />
            {chatInput.trim() ? (
              <button
                type="submit"
                className="w-12 h-12 rounded-full bg-[#2E531A] text-white flex items-center justify-center shadow-sm shrink-0"
                aria-label="전송"
              >
                <Send className="w-5 h-5" />
              </button>
            ) : (
              <button
                type="button"
                onClick={() =>
                  handleSendChat('성인 2명 얼큰한 국물 요리 2만 5천원 이하로 추천해줘')
                }
                title="음성 명령 시연 실행"
                className="w-12 h-12 rounded-full bg-[#2E531A] hover:bg-[#234113] text-white flex items-center justify-center shadow-sm shrink-0 transition"
                aria-label="음성 주문 시연"
              >
                <Mic className="w-5 h-5" />
              </button>
            )}
          </form>
        </div>
      </div>
    );
  };

  // (B) 메뉴 상세 & AI 리뷰 요약 & 15분 단위 정밀 예약배달 (첨부 이미지 3-1)
  const renderMenuDetailView = (menuId: string, isGroupBuy?: boolean, groupBuyId?: string) => {
    const menu = menus.find((m) => m.id === menuId) || menus[0];
    const gbDeal = groupBuyId ? groupBuys.find((g) => g.id === groupBuyId) : undefined;
    const wished = wishlistIds.includes(menu.id);

    const selectedOpt =
      menu.options.find((o) => o.id === detailOptionId) || menu.options[0];
    const basePrice = gbDeal ? gbDeal.groupPrice : selectedOpt?.price ?? menu.price;
    const addonsTotal = menu.addons
      .filter((a) => detailAddonIds.includes(a.id))
      .reduce((acc, cur) => acc + cur.price, 0);
    const unitTotal = basePrice + addonsTotal;
    const safeQty = sanitizeQuantity(detailQty);
    const grandSubtotal = unitTotal * safeQty;

    const reservationSlots = [
      `즉시 배달 (약 ${menu.deliveryMinutes}분)`,
      '오늘 12:15 정밀 도착',
      '오늘 12:30 정밀 도착',
      '오늘 18:45 퇴근맞춤 도착',
      '오늘 19:00 정밀 도착',
    ];

    return (
      <div className="flex flex-col h-full bg-white">
        {/* 상단 네비게이션 */}
        <div className="flex items-center justify-between px-4 py-3 bg-white border-b border-black/5">
          <button
            onClick={() => setSubView({ type: 'none' })}
            className="p-2 -ml-2 rounded-full hover:bg-black/5"
            aria-label="뒤로가기"
          >
            <ChevronLeft className="w-6 h-6 text-[#1E241B]" />
          </button>
          <span className="text-xs font-semibold text-[#486B28] bg-[#EAF1E1] px-2.5 py-1 rounded-full">
            단일가격 보증 · 중개수수료 0% (시연)
          </span>
          <div className="flex items-center gap-1">
            <button
              onClick={() => toggleWishlist(menu.id)}
              className="p-2 rounded-full hover:bg-black/5"
              aria-label="찜하기"
            >
              <Heart
                className={`w-5 h-5 ${wished ? 'fill-red-500 text-red-500' : 'text-gray-700'}`}
              />
            </button>
            <button
              onClick={() => handleShareDemo(`${menu.storeName} - ${menu.name}`)}
              className="p-2 rounded-full hover:bg-black/5"
              aria-label="공유하기"
            >
              <Share2 className="w-5 h-5 text-gray-700" />
            </button>
          </div>
        </div>

        {/* 스크롤 본문 */}
        <div className="flex-1 overflow-y-auto px-4 pb-6 space-y-5">
          {/* 음식 이미지 배너 */}
          <div className="mt-2 rounded-2xl overflow-hidden shadow-sm border border-black/5 relative">
            <DishIllustration art={menu.dishArt} className="w-full h-48" />
            {typeof menu.remainingLimited === 'number' && (
              <span className="absolute bottom-2.5 left-2.5 bg-black/75 text-white text-[11px] font-bold px-3 py-1 rounded-full">
                🔥 당일 준비재료 남은 수량 {menu.remainingLimited}개
              </span>
            )}
          </div>

          {/* 제목 & 별점 */}
          <div>
            <div className="flex items-center justify-between">
              <h1 className="text-2xl font-extrabold text-[#1E241B]">{menu.name}</h1>
              {isGroupBuy && gbDeal && (
                <span className="bg-[#486B28] text-white text-xs font-bold px-2.5 py-1 rounded-full">
                  공동구매 {gbDeal.discountPercent}%↓
                </span>
              )}
            </div>
            <div className="flex items-center gap-1.5 text-sm text-gray-600 mt-1">
              <Star className="w-4 h-4 fill-[#486B28] text-[#486B28]" />
              <span className="font-bold text-[#1E241B]">{menu.rating}</span>
              <span>({menu.reviewCount.toLocaleString()})</span>
              <span>· 배달 {menu.deliveryMinutes}분</span>
            </div>
            <p className="text-sm text-gray-600 mt-2.5 leading-relaxed">{menu.description}</p>
          </div>

          {/* 매장 카드 */}
          <div className="flex items-center justify-between px-3.5 py-3 rounded-2xl bg-[#F7F7F5] border border-black/5">
            <div className="flex items-center gap-2">
              <Store className="w-4 h-4 text-[#486B28]" />
              <span className="font-bold text-sm text-[#1E241B]">{menu.storeName}</span>
            </div>
            <button
              onClick={() => {
                setSubView({ type: 'none' });
                setActiveTab('search');
                setSearchQuery(menu.storeName);
              }}
              className="text-xs text-gray-500 font-medium flex items-center gap-0.5 hover:text-[#486B28]"
            >
              가게 더보기 <ChevronRight className="w-3.5 h-3.5" />
            </button>
          </div>

          {/* AI 리뷰 장단점 요약 (제안서 §1 핵심 기능) */}
          <div className="rounded-2xl bg-[#F4F8EF] border border-[#DCE8CF] p-3.5 space-y-2.5">
            <div className="flex items-center gap-1.5 text-xs font-extrabold text-[#3B5920]">
              <Sparkles className="w-4 h-4" />
              <span>AI 포탈·올이 리뷰 핵심 요약 (시연 데이터)</span>
            </div>
            <div className="space-y-1.5 text-xs">
              {menu.aiPros.map((pro, idx) => (
                <div key={idx} className="flex items-start gap-1.5 text-[#1E241B]">
                  <span className="text-[#486B28] font-bold shrink-0">👍 장점:</span>
                  <span>{pro}</span>
                </div>
              ))}
              {menu.aiCons.map((con, idx) => (
                <div key={idx} className="flex items-start gap-1.5 text-gray-600">
                  <span className="text-amber-700 font-bold shrink-0">💡 참고:</span>
                  <span>{con}</span>
                </div>
              ))}
            </div>
          </div>

          {/* 메뉴 선택 */}
          <div className="space-y-2">
            <h2 className="font-bold text-base text-[#1E241B]">메뉴 선택</h2>
            <div className="space-y-2">
              {menu.options.map((opt) => {
                const checked = selectedOpt?.id === opt.id;
                const displayPrice = gbDeal ? gbDeal.groupPrice : opt.price;
                return (
                  <button
                    key={opt.id}
                    type="button"
                    onClick={() => setDetailOptionId(opt.id)}
                    className={`w-full flex items-center justify-between px-4 py-3.5 rounded-2xl border text-left transition ${
                      checked
                        ? 'bg-[#F2F7EC] border-[#567C32]'
                        : 'bg-white border-gray-200 hover:bg-gray-50'
                    }`}
                  >
                    <div className="flex items-center gap-3">
                      <span
                        className={`w-5 h-5 rounded-full flex items-center justify-center border ${
                          checked
                            ? 'border-[#486B28] bg-[#486B28] text-white'
                            : 'border-gray-300'
                        }`}
                      >
                        {checked && <Check className="w-3 h-3" />}
                      </span>
                      <span className="font-semibold text-sm text-[#1E241B]">{opt.name}</span>
                    </div>
                    <span className="font-bold text-sm text-[#3B5920]">
                      {formatKRW(displayPrice)}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>

          {/* 추가 옵션 */}
          {menu.addons.length > 0 && (
            <div className="space-y-2">
              <h2 className="font-bold text-base text-[#1E241B]">추가 옵션</h2>
              <div className="space-y-2">
                {menu.addons.map((addon) => {
                  const checked = detailAddonIds.includes(addon.id);
                  return (
                    <button
                      key={addon.id}
                      type="button"
                      onClick={() =>
                        setDetailAddonIds((prev) =>
                          checked ? prev.filter((id) => id !== addon.id) : [...prev, addon.id]
                        )
                      }
                      className={`w-full flex items-center justify-between px-4 py-3 rounded-2xl border text-left transition ${
                        checked ? 'bg-[#F7FAF3] border-[#567C32]' : 'bg-white border-gray-200'
                      }`}
                    >
                      <div className="flex items-center gap-3">
                        <span
                          className={`w-5 h-5 rounded-md flex items-center justify-center border ${
                            checked
                              ? 'bg-[#486B28] border-[#486B28] text-white'
                              : 'border-gray-300'
                          }`}
                        >
                          {checked && <Check className="w-3.5 h-3.5" />}
                        </span>
                        <span className="text-sm font-medium text-[#1E241B]">{addon.name}</span>
                      </div>
                      <span className="text-sm font-semibold text-gray-600">
                        +{formatKRW(addon.price)}
                      </span>
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          {/* 15분 단위 정밀 예약배달 선택 (제안서 §1) */}
          <div className="space-y-2">
            <div className="flex items-center justify-between">
              <h2 className="font-bold text-sm text-[#1E241B] flex items-center gap-1.5">
                <Clock className="w-4 h-4 text-[#486B28]" />
                <span>도착 희망 시간 (15분 단위 정밀 예약)</span>
              </h2>
            </div>
            <div className="flex gap-2 overflow-x-auto pb-1 no-scrollbar">
              {reservationSlots.map((slot) => (
                <button
                  key={slot}
                  type="button"
                  onClick={() => setDetailReservationSlot(slot)}
                  className={`shrink-0 px-3 py-2 rounded-xl text-xs font-semibold border transition ${
                    detailReservationSlot === slot
                      ? 'bg-[#486B28] text-white border-[#486B28]'
                      : 'bg-[#F7F7F5] text-gray-700 border-gray-200'
                  }`}
                >
                  {slot}
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* 하단 고정 주문 바 */}
        <div className="p-4 bg-white border-t border-black/10 flex items-center gap-3">
          <div className="flex items-center gap-3 bg-[#F7F7F5] rounded-2xl px-3 py-2.5 border border-black/5">
            <button
              onClick={() => setDetailQty((q) => sanitizeQuantity(q - 1))}
              className="w-7 h-7 rounded-full bg-white flex items-center justify-center shadow-2xs"
              aria-label="수량 감소"
            >
              <Minus className="w-4 h-4" />
            </button>
            <span className="font-bold text-base w-5 text-center">{safeQty}</span>
            <button
              onClick={() => setDetailQty((q) => sanitizeQuantity(q + 1))}
              className="w-7 h-7 rounded-full bg-white flex items-center justify-center shadow-2xs"
              aria-label="수량 증가"
            >
              <Plus className="w-4 h-4" />
            </button>
          </div>

          <button
            onClick={() =>
              triggerOrderConfirmation({
                menu,
                optionName: selectedOpt?.name || '기본',
                unitPrice: unitTotal,
                quantity: safeQty,
                deliveryFee: isGroupBuy ? 500 : menu.deliveryFee,
                deliveryMode: isGroupBuy ? '공동구매 묶음' : '이웃 도보 (Track 1)',
                reservationTime: detailReservationSlot.startsWith('즉시')
                  ? undefined
                  : detailReservationSlot,
                groupBuyId,
              })
            }
            className="flex-1 py-3.5 rounded-2xl bg-[#486B28] hover:bg-[#3A5720] text-white font-bold text-base shadow-md transition"
          >
            주문하기 · {formatKRW(grandSubtotal)}
          </button>
        </div>
      </div>
    );
  };

  // (C) 이웃 공동구매 화면 (첨부 이미지 3-2)
  const renderGroupBuyView = () => {
    const filtered = groupBuys.filter((g) => g.status === gbTab);
    return (
      <div className="flex flex-col h-full bg-[#F7F7F5]">
        <div className="flex items-center justify-between px-4 py-3 bg-[#F7F7F5]">
          <button
            onClick={() => setSubView({ type: 'none' })}
            className="p-2 -ml-2 rounded-full hover:bg-black/5"
          >
            <ChevronLeft className="w-6 h-6 text-[#1E241B]" />
          </button>
          <span className="text-xs text-gray-500 font-medium">반경 300m 이웃 AI 매칭</span>
          <button
            onClick={() => handleShareDemo('이웃 공동구매 모집')}
            className="p-2 rounded-full hover:bg-black/5"
          >
            <Share2 className="w-5 h-5 text-gray-700" />
          </button>
        </div>

        <div className="px-5 pt-1 pb-4 text-center space-y-2">
          <div className="w-12 h-12 rounded-2xl bg-[#EAF1E1] text-[#486B28] flex items-center justify-center mx-auto">
            <Users className="w-6 h-6" />
          </div>
          <h1 className="text-2xl font-extrabold text-[#1E241B]">이웃 공동구매</h1>
          <p className="text-sm text-gray-500 leading-snug">
            우리 동네 이웃과 함께 주문하고
            <br />더 저렴하게 즐겨요!
          </p>
        </div>

        {/* 탭 */}
        <div className="grid grid-cols-2 border-b border-gray-200 bg-white">
          <button
            onClick={() => setGbTab('ongoing')}
            className={`py-3 text-sm font-bold border-b-2 transition ${
              gbTab === 'ongoing'
                ? 'border-[#486B28] text-[#1E241B]'
                : 'border-transparent text-gray-400'
            }`}
          >
            진행중
          </button>
          <button
            onClick={() => setGbTab('upcoming')}
            className={`py-3 text-sm font-bold border-b-2 transition ${
              gbTab === 'upcoming'
                ? 'border-[#486B28] text-[#1E241B]'
                : 'border-transparent text-gray-400'
            }`}
          >
            오픈예정
          </button>
        </div>

        {/* 카드 목록 */}
        <div className="flex-1 overflow-y-auto p-4 space-y-4">
          {filtered.map((deal) => {
            const pct = Math.min(
              100,
              Math.round((deal.currentParticipants / deal.targetParticipants) * 100)
            );
            const wished = wishlistIds.includes(deal.menuId);
            return (
              <div
                key={deal.id}
                className="bg-white rounded-3xl overflow-hidden shadow-sm border border-black/5"
              >
                <div className="relative">
                  <DishIllustration art={deal.dishArt} className="w-full h-36" />
                  <span className="absolute top-3 left-3 bg-[#486B28] text-white text-xs font-bold px-3 py-1 rounded-full">
                    공동구매
                  </span>
                  <button
                    onClick={() => toggleWishlist(deal.menuId)}
                    className="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 flex items-center justify-center shadow-sm"
                  >
                    <Heart
                      className={`w-4 h-4 ${
                        wished ? 'fill-red-500 text-red-500' : 'text-gray-600'
                      }`}
                    />
                  </button>
                </div>

                <div className="p-4 space-y-3">
                  <div>
                    <h2 className="text-lg font-extrabold text-[#1E241B]">{deal.storeName}</h2>
                    <div className="flex items-center gap-2 mt-1">
                      <span className="text-sm text-gray-400 line-through">
                        {formatKRW(deal.originalPrice)}
                      </span>
                      <span className="text-base font-extrabold text-[#486B28]">
                        → {formatKRW(deal.groupPrice)} ({deal.discountPercent}%↓)
                      </span>
                    </div>
                  </div>

                  {/* 참여 프로그레스 바 */}
                  <div className="space-y-1.5">
                    <div className="flex items-center justify-between text-xs">
                      <span className="font-semibold text-[#1E241B] flex items-center gap-1">
                        <Users className="w-3.5 h-3.5 text-[#486B28]" />
                        현재 {deal.currentParticipants}명 참여중
                      </span>
                      <span className="text-gray-400">목표 {deal.targetParticipants}명</span>
                    </div>
                    <div className="w-full h-2.5 bg-gray-100 rounded-full overflow-hidden">
                      <div
                        className="h-full bg-[#689F38] rounded-full transition-all duration-300"
                        style={{ width: `${pct}%` }}
                      />
                    </div>
                  </div>

                  <div className="flex items-center gap-1.5 text-xs text-gray-500">
                    <Clock className="w-3.5 h-3.5" />
                    <span>{deal.remainingTimeText}</span>
                  </div>

                  <button
                    onClick={() => openMenuDetail(deal.menuId, true, deal.id)}
                    className="w-full py-3 rounded-2xl bg-[#EAF1E1] hover:bg-[#DCE9CC] text-[#3B5920] font-bold text-sm transition"
                  >
                    {deal.status === 'ongoing' ? '함께 주문하기' : '오픈 알림 & 미리보기'}
                  </button>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    );
  };

  // (D) 배달비 매칭 화면 (첨부 이미지 3-3)
