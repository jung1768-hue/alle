  const renderOrdersTab = () => {
    // 2월 달력 (2026-02-01 ~ 28, 1일이 일요일 또는 첨부 이미지 레이아웃 기준 28일 그리드)
    const daysInMonth = Array.from({ length: 28 }, (_, i) => i + 1);
    const ordersByDay = new Map<number, OrderRecord[]>();
