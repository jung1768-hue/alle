const STORAGE_KEY = 'alle_hyperlocal_demo_state_v1';

function checkStorageAvailable(): boolean {
  try {
    const testKey = '__alle_storage_test__';
    window.localStorage.setItem(testKey, '1');
    window.localStorage.removeItem(testKey);
    return true;
  } catch {
    return false;
  }
}

// 양의 정수 수량 검증 (Positive integer >= 1)
function sanitizeQuantity(qty: number): number {
  if (!Number.isFinite(qty) || Number.isNaN(qty)) return 1;
  return Math.max(1, Math.floor(qty));
}

// 원 단위 정수 금액 포맷
function formatKRW(amount: number): string {
  const safe = Math.max(0, Math.round(Number.isFinite(amount) ? amount : 0));
  return `${safe.toLocaleString('ko-KR')}원`;
}

// 최적 할인 자동 계산 (상품할인 쿠폰이 절대 상품합계보다 커지지 않도록 보장)
function calculateBestCoupon(
  itemsSubtotal: number,
  coupons: CouponItem[]
): { coupon: CouponItem | null; appliedDiscount: number } {
  const safeSubtotal = Math.max(0, Math.round(itemsSubtotal));
  let bestCoupon: CouponItem | null = null;
  let bestDiscount = 0;

  for (const cp of coupons) {
    if (safeSubtotal >= cp.minOrderAmount) {
      // 핵심 검증: 상품할인 쿠폰이 상품합계(itemsSubtotal)를 초과할 수 없음
      const clampedDiscount = Math.min(safeSubtotal, Math.max(0, Math.round(cp.discountAmount)));
      if (clampedDiscount > bestDiscount) {
        bestDiscount = clampedDiscount;
        bestCoupon = cp;
      }
    }
  }
  return { coupon: bestCoupon, appliedDiscount: bestDiscount };
}

// 규칙 기반 로컬 자연어 추천/검색 엔진 (실제 Gemini 호출은 후속 단계로 분리)
function runRuleBasedRecommender(query: string, menus: MenuItem[]): {
  replyText: string;
  matchedMenus: MenuItem[];
  quickOrderMenu: MenuItem;
} {
  const q = query.trim().toLowerCase();

  // 예산 파싱 (예: "2만 5천원 이하", "25000원 이하", "1만원 이하")
  let maxBudget: number | null = null;
  const manCheonMatch = q.match(/(\d+)\s*만\s*(\d+)\s*천/);
  const manMatch = q.match(/(\d+)\s*만/);
  const numWonMatch = q.match(/(\d{4,6})\s*원?/);

  if (manCheonMatch) {
    maxBudget = parseInt(manCheonMatch[1], 10) * 10000 + parseInt(manCheonMatch[2], 10) * 1000;
  } else if (manMatch) {
    maxBudget = parseInt(manMatch[1], 10) * 10000;
  } else if (numWonMatch) {
    maxBudget = parseInt(numWonMatch[1], 10);
  }

  let candidates = menus.filter((m) => m.isAvailableNow);

  if (maxBudget !== null && maxBudget > 0) {
    const withinBudget = candidates.filter((m) => m.price <= maxBudget!);
    if (withinBudget.length > 0) {
      candidates = withinBudget;
    }
  }

  // 키워드 가중치 점수 계산
  const scored = candidates.map((menu) => {
    let score = menu.rating * 2;
    if (q.includes('국물') || q.includes('따뜻') || q.includes('한식') || q.includes('해장')) {
      if (menu.tags.includes('국물') || menu.category === '한식/국물') score += 15;
    }
    if (q.includes('얼큰') || q.includes('매운') || q.includes('칼칼')) {
      if (menu.tags.includes('얼큰')) score += 15;
    }
    if (q.includes('치킨') || q.includes('야식') || q.includes('바삭')) {
      if (menu.category === '치킨') score += 18;
    }
    if (q.includes('짜장') || q.includes('중식') || q.includes('면')) {
      if (menu.category === '중식') score += 18;
    }
    if (q.includes('커피') || q.includes('라떼') || q.includes('카페')) {
      if (menu.category === '카페/디저트') score += 18;
    }
    if (q.includes('샐러드') || q.includes('다이어트') || q.includes('가벼')) {
      if (menu.category === '샐러드/분식') score += 18;
    }
    if (q.includes('빠른') || q.includes('빨리') || q.includes('30분')) {
      if (menu.deliveryMinutes <= 28) score += 8;
    }
    // 직접 메뉴/가게명 매칭
    if (q.includes(menu.name.toLowerCase()) || q.includes(menu.storeName.toLowerCase())) {
      score += 25;
    }
    return { menu, score };
  });

  scored.sort((a, b) => b.score - a.score);
  const topMenus = scored.slice(0, 3).map((s) => s.menu);
  const best = topMenus[0] || menus[0];

  let replyText = '따뜻한 국물 요리로 이 근처의 인기 메뉴를 추천해드릴게요! 😊';
  if (q.includes('치킨') || q.includes('야식')) {
    replyText = '지금 바로 바삭하게 튀겨 25분 내 도착하는 우리 동네 인기 치킨이에요! 🍗';
  } else if (q.includes('짜장') || q.includes('중식')) {
    replyText = '불지 않고 20분 만에 도착하는 단일가격 보증 중식 메뉴를 찾았어요! 🍜';
  } else if (q.includes('커피') || q.includes('라떼')) {
    replyText = '이웃 도보 배달(1,000원)로 한 잔도 부담 없는 카페 메뉴예요! ☕';
  } else if (q.includes('샐러드') || q.includes('다이어트')) {
    replyText = '가볍고 든든하게 즐기기 좋은 신선 샐러드 메뉴를 골라봤어요! 🥗';
  } else if (maxBudget) {
    replyText = `${formatKRW(maxBudget)} 이하 조건에 딱 맞는 지금 주문 가능한 맛집이에요! ✨`;
  }

  return {
    replyText,
    matchedMenus: topMenus,
    quickOrderMenu: best,
  };
}

