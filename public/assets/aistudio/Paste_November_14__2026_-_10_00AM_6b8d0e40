      const parts = o.dateStr.split('-');
      const m = parseInt(parts[1], 10);
      const d = parseInt(parts[2], 10);
      if (m === selectedMonth) {
        const list = ordersByDay.get(d) || [];
        list.push(o);
        ordersByDay.set(d, list);
      }
    });

    const selectedDayNum = parseInt(selectedDateStr.split('-')[2] || '22', 10);
    const dayOrders = ordersByDay.get(selectedDayNum) || [];
    const dayTotalAmount = dayOrders.reduce((sum, o) => sum + o.totalPaid, 0);

    const activeOrder = orders[0];

    // AI 10초 무인 CS 자동 중재 시연 (제안서 §7)
    const handleRunAutoCS = (orderId: string) => {
      setOrders((prev) =>
        prev.map((o) =>
          o.id === orderId
            ? {
                ...o,
                csResolved:
                  'AI 4중 크로스체크 완료 (8.4초): 점주 실링 정상 + 배달원 IMU 충격 로그 확인 → 고객 전액 보상 쿠폰 즉시 발급 & 점주 100% 정상 정산 처리됨',
              }
            : o
        )
      );
      showToast('⚡ AI 10초 무인 CS 판정 및 자동 보상이 완료되었습니다!');
    };

    return (
      <div className="px-4 pt-3 pb-6 space-y-4">
        <h1 className="text-2xl font-extrabold text-[#1E241B]">주문내역</h1>

        {/* 주문현황 / 주문기록 세그먼트 탭 */}
        <div className="grid grid-cols-2 bg-[#ECEEE9] p-1 rounded-2xl">
          <button
            onClick={() => setOrdersSubTab('status')}
            className={`py-2.5 rounded-xl text-sm font-bold transition ${
              ordersSubTab === 'status'
                ? 'bg-[#DCE8CF] text-[#283B17] shadow-2xs'
                : 'text-gray-500'
            }`}
          >
            주문현황
          </button>
          <button
            onClick={() => setOrdersSubTab('history')}
            className={`py-2.5 rounded-xl text-sm font-bold transition ${
              ordersSubTab === 'history'
                ? 'bg-[#DCE8CF] text-[#283B17] shadow-2xs'
                : 'text-gray-500'
            }`}
          >
            주문기록
          </button>
        </div>

        {ordersSubTab === 'status' ? (
          /* 실시간 4단계 라이브 관제 & AI 10초 무인 CS */
          <div className="space-y-4">
            {activeOrder && (
              <div className="bg-white rounded-3xl p-4 shadow-sm border border-black/5 space-y-4">
                <div className="flex items-center justify-between">
                  <div>
                    <span className="text-[11px] font-bold text-[#486B28] bg-[#EAF1E1] px-2.5 py-0.5 rounded-full">
                      {activeOrder.deliveryMode}
                    </span>
                    <h2 className="text-lg font-extrabold text-[#1E241B] mt-1.5">
                      {activeOrder.storeName} · {activeOrder.menuName}
                    </h2>
                  </div>
                  <div className="text-right">
                    <div className="text-xs text-gray-400">Dynamic ETA</div>
                    <div className="text-base font-extrabold text-[#486B28]">약 14분 후 도착</div>
                  </div>
                </div>

                {/* 4단계 진행 바 */}
                <div className="grid grid-cols-4 gap-1.5 pt-1">
                  {[
                    { step: 1, label: '주문 접수' },
                    { step: 2, label: '조리 중' },
                    { step: 3, label: '픽업 완료' },
                    { step: 4, label: '배송 완료' },
                  ].map((s) => {
                    const done = activeOrder.statusStep >= s.step;
                    return (
                      <div key={s.step} className="space-y-1.5 text-center">
                        <div
                          className={`h-2 rounded-full ${
                            done ? 'bg-[#486B28]' : 'bg-gray-200'
                          }`}
                        />
                        <div
                          className={`text-[11px] font-bold ${
                            done ? 'text-[#486B28]' : 'text-gray-400'
                          }`}
                        >
                          {s.label}
                        </div>
                      </div>
                    );
                  })}
                </div>

                {/* 지오펜싱 마스킹 안내 (제안서 §5) */}
                <div className="bg-[#F7F7F5] rounded-2xl p-3 text-xs text-gray-600 flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <Radio className="w-4 h-4 text-[#486B28] animate-pulse" />
                    <span>지오펜싱 마스킹 활성: 이웃 파트너 자택 동선 비공개 보호중</span>
                  </div>
                  <button
                    onClick={() =>
                      setOrders((prev) =>
                        prev.map((o, i) =>
                          i === 0
                            ? {
                                ...o,
                                statusStep: ((o.statusStep % 4) + 1) as 1 | 2 | 3 | 4,
                              }
                            : o
                        )
                      )
                    }
                    className="text-[11px] font-bold text-[#486B28] underline shrink-0"
                  >
                    단계 진행
                  </button>
                </div>

                {/* AI 10초 무인 CS 중재 버튼 */}
                <div className="pt-1 border-t border-gray-100 space-y-2">
                  <button
                    onClick={() => handleRunAutoCS(activeOrder.id)}
                    className="w-full py-2.5 rounded-xl bg-[#F3F6EE] hover:bg-[#E6EEDD] text-[#3B5920] font-bold text-xs flex items-center justify-center gap-1.5 transition"
                  >
                    <ShieldCheck className="w-4 h-4" />
                    <span>AI 10초 무인 CS 자동 판정 시연 (파손/누락 크로스체크)</span>
                  </button>
                  {activeOrder.csResolved && (
                    <div className="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-900 leading-relaxed">
                      {activeOrder.csResolved}
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>
        ) : (
          /* 주문기록 월별 음식 달력 (첨부 이미지 4번 디자인 구현) */
          <div className="space-y-4">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-1 bg-white p-1 rounded-full border border-black/5">
                <button
                  onClick={() => setCalendarMode('monthly')}
                  className={`px-3 py-1 rounded-full text-xs font-bold ${
                    calendarMode === 'monthly'
                      ? 'bg-[#DCE8CF] text-[#283B17]'
                      : 'text-gray-500'
                  }`}
                >
                  월별
                </button>
                <button
                  onClick={() => setCalendarMode('yearly')}
                  className={`px-3 py-1 rounded-full text-xs font-bold ${
                    calendarMode === 'yearly'
                      ? 'bg-[#DCE8CF] text-[#283B17]'
                      : 'text-gray-500'
                  }`}
                >
                  연간
                </button>
              </div>

              <div className="flex items-center gap-3 font-extrabold text-lg text-[#1E241B]">
                <button
                  onClick={() => setSelectedMonth((m) => (m === 1 ? 12 : m - 1))}
                  className="p-1 hover:bg-black/5 rounded-full"
                >
                  <ChevronLeft className="w-4 h-4" />
                </button>
                <span>{selectedMonth}월</span>
                <button
                  onClick={() => setSelectedMonth((m) => (m === 12 ? 1 : m + 1))}
                  className="p-1 hover:bg-black/5 rounded-full"
                >
                  <ChevronRight className="w-4 h-4" />
                </button>
              </div>

              <button
                onClick={() => {
                  setSelectedMonth(2);
                  setSelectedDateStr('2026-02-22');
                }}
                className="p-2 rounded-xl bg-white border border-black/5 text-gray-600"
                title="2월 22일로 이동"
              >
                <CalendarIcon className="w-4 h-4" />
              </button>
            </div>

            {calendarMode === 'yearly' ? (
              <div className="bg-white rounded-3xl p-4 border border-black/5 grid grid-cols-3 gap-2.5">
                {Array.from({ length: 12 }, (_, idx) => idx + 1).map((m) => {
                  const count = orders.filter(
                    (o) => parseInt(o.dateStr.split('-')[1], 10) === m
                  ).length;
                  return (
                    <button
                      key={m}
                      onClick={() => {
                        setSelectedMonth(m);
                        setCalendarMode('monthly');
                      }}
                      className={`p-3 rounded-2xl border text-center ${
                        m === selectedMonth
                          ? 'bg-[#EAF1E1] border-[#486B28] font-bold'
                          : 'bg-[#F7F7F5] border-transparent'
                      }`}
                    >
                      <div className="text-sm font-bold text-[#1E241B]">{m}월</div>
                      <div className="text-xs text-[#486B28] mt-0.5">{count}건 주문</div>
                    </button>
                  );
                })}
              </div>
            ) : (
              <>
                {/* 요일 헤더 & 달력 그리드 */}
                <div className="space-y-1.5">
                  <div className="grid grid-cols-7 text-center text-xs font-medium text-gray-400">
                    {['월', '화', '수', '목', '금', '토', '일'].map((w) => (
                      <div key={w} className="py-1">
                        {w}
                      </div>
                    ))}
                  </div>

                  <div className="grid grid-cols-7 gap-1.5">
                    {daysInMonth.map((day) => {
                      const dayList = ordersByDay.get(day) || [];
                      const isSelected = day === selectedDayNum;
                      const formattedDate = `2026-${String(selectedMonth).padStart(
                        2,
                        '0'
                      )}-${String(day).padStart(2, '0')}`;
                      return (
                        <button
                          key={day}
                          onClick={() => setSelectedDateStr(formattedDate)}
                          className={`aspect-[1/1.18] rounded-2xl p-1 flex flex-col items-center justify-between transition border ${
                            isSelected
                              ? 'bg-[#EAF1E1] border-[#486B28] shadow-2xs'
                              : 'bg-[#EFEFEA]/70 border-transparent hover:bg-white'
                          }`}
                        >
                          <span
                            className={`text-[11px] font-bold ${
                              isSelected ? 'text-[#283B17]' : 'text-gray-700'
                            }`}
                          >
                            {day}
                          </span>
                          {dayList.length > 0 ? (
                            <div className="w-8 h-8 rounded-full overflow-hidden border border-white shadow-2xs">
                              <DishIllustration
                                art={dayList[0].dishArt}
                                className="w-full h-full"
                              />
                            </div>
                          ) : (
                            <div className="w-7 h-7" />
                          )}
                        </button>
                      );
                    })}
                  </div>
                </div>

                {/* 선택된 날짜의 주문 상세 & 1초 결제 재주문 카드 (첨부 이미지 4번 하단 시트) */}
                <div className="bg-white rounded-3xl p-4 shadow-sm border border-black/5 space-y-3.5">
                  <div className="w-8 h-1 bg-gray-200 rounded-full mx-auto" />
                  <div className="flex items-center justify-between">
                    <span className="text-lg font-extrabold text-[#1E241B]">
                      {selectedMonth}월 {selectedDayNum}일
                    </span>
                    <span className="text-xs font-bold text-[#486B28]">
                      총 {dayOrders.length}건 · {formatKRW(dayTotalAmount)}
                    </span>
                  </div>

                  {dayOrders.length === 0 ? (
                    <div className="py-6 text-center text-xs text-gray-400">
                      선택한 날짜의 시연 주문 내역이 없습니다. (2월 22일 등을 눌러보세요)
                    </div>
                  ) : (
                    <div className="space-y-3">
                      {dayOrders.map((ord, idx) => {
                        const targetMenu =
                          menus.find((m) => m.id === ord.menuId) || menus[0];
                        return (
                          <div key={ord.id} className="space-y-2.5">
                            <div className="flex items-center justify-between gap-2.5">
                              <div className="flex items-center gap-3">
                                <div className="w-12 h-12 rounded-2xl overflow-hidden shrink-0 border border-black/5">
                                  <DishIllustration
                                    art={ord.dishArt}
                                    className="w-full h-full"
                                  />
                                </div>
                                <div>
                                  <div className="font-extrabold text-sm text-[#1E241B]">
                                    {ord.storeName}
                                  </div>
                                  <div className="text-xs text-gray-500">{ord.menuName}</div>
                                  <div className="text-[11px] text-gray-400 mt-0.5">
                                    {ord.timeStr}
                                  </div>
                                </div>
                              </div>

                              <div className="text-right space-y-1.5">
                                <div className="font-extrabold text-sm text-[#1E241B]">
                                  {formatKRW(ord.totalPaid)}
                                </div>
                                {idx > 0 && (
                                  <button
                                    onClick={() =>
                                      triggerOrderConfirmation({
                                        menu: targetMenu,
                                        optionName: ord.optionName,
                                        unitPrice: ord.itemsSubtotal / ord.quantity,
                                        quantity: ord.quantity,
                                        deliveryFee: ord.deliveryFee,
                                        deliveryMode: '이웃 도보 (Track 1)',
                                      })
                                    }
                                    className="px-3 py-1.5 rounded-full bg-[#EAF1E1] text-[#3B5920] font-bold text-xs flex items-center gap-1"
                                  >
                                    <Zap className="w-3 h-3 fill-current" /> 1초 결제
                                  </button>
                                )}
                              </div>
                            </div>

                            {idx === 0 && (
                              <button
                                onClick={() =>
                                  triggerOrderConfirmation({
                                    menu: targetMenu,
                                    optionName: ord.optionName,
                                    unitPrice: ord.itemsSubtotal / ord.quantity,
                                    quantity: ord.quantity,
                                    deliveryFee: ord.deliveryFee,
                                    deliveryMode: '이웃 도보 (Track 1)',
                                  })
                                }
                                className="w-full py-3 rounded-2xl bg-[#486B28] hover:bg-[#3A5720] text-white font-bold text-sm flex items-center justify-center gap-1.5 shadow-sm transition"
                              >
                                <Zap className="w-4 h-4 fill-current" /> 1초 결제
                              </button>
                            )}
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>
              </>
            )}
          </div>
        )}
      </div>
    );
  };

  // [탭 4] 찜 화면
  const renderWishlistTab = () => {
    const wishedMenus = menus.filter((m) => wishlistIds.includes(m.id));
    return (
      <div className="px-4 pt-3 pb-6 space-y-4">
        <div className="flex items-center justify-between">
          <h1 className="text-2xl font-extrabold text-[#1E241B]">찜한 단골 메뉴</h1>
          <span className="text-xs font-bold text-[#486B28]">{wishedMenus.length}개</span>
        </div>

        {wishedMenus.length === 0 ? (
          <div className="bg-white rounded-3xl p-8 text-center space-y-3 border border-black/5">
            <Heart className="w-8 h-8 text-gray-300 mx-auto" />
            <p className="text-sm text-gray-500">아직 찜한 메뉴가 없어요.</p>
            <button
              onClick={() => setActiveTab('search')}
              className="px-4 py-2 rounded-xl bg-[#486B28] text-white text-xs font-bold"
            >
              우리 동네 맛집 둘러보기
            </button>
          </div>
        ) : (
          <div className="space-y-3">
            {wishedMenus.map((item) => (
              <div
                key={item.id}
                className="bg-white rounded-2xl p-3.5 shadow-2xs border border-black/5 flex items-center justify-between gap-3"
              >
                <div
                  onClick={() => openMenuDetail(item.id)}
                  className="flex items-center gap-3 flex-1 cursor-pointer"
                >
                  <div className="w-16 h-16 rounded-xl overflow-hidden shrink-0">
                    <DishIllustration art={item.dishArt} className="w-full h-full" />
                  </div>
                  <div>
                    <div className="font-extrabold text-sm text-[#1E241B]">{item.name}</div>
                    <div className="text-xs text-gray-500">{item.storeName}</div>
                    <div className="text-xs font-bold text-[#486B28] mt-1">
                      {formatKRW(item.price)} · {item.deliveryMinutes}분
                    </div>
                  </div>
                </div>
                <div className="flex items-center gap-1.5">
                  <button
                    onClick={() =>
                      triggerOrderConfirmation({
                        menu: item,
                        optionName: item.options[0].name,
                        unitPrice: item.price,
                        quantity: 1,
                        deliveryFee: item.deliveryFee,
                        deliveryMode: '이웃 도보 (Track 1)',
                      })
                    }
                    className="px-3 py-2 rounded-xl bg-[#EAF1E1] text-[#3B5920] font-bold text-xs"
                  >
                    1초 주문
                  </button>
                  <button
                    onClick={() => toggleWishlist(item.id)}
                    className="p-2 text-red-500"
                    aria-label="찜 해제"
                  >
                    <Heart className="w-4 h-4 fill-current" />
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    );
  };

  // [탭 5] MY & 같은 브라우저 역할 전환 시연 (고객 / 점주 AI 포스 / 이웃 파트너·라이더)
  const renderMyTab = () => {
    const handleMockTopup = () => {
      const topupAmount = 10000;
      setConfirmModal({
        isOpen: true,
        title: '올이페이 모의 충전 10,000원',
        subtitle: '시연용 가상 잔액 충전 (실제 계좌이체/결제가 발생하지 않습니다)',
        itemsSubtotal: topupAmount,
        couponDiscount: 0,
        deliveryFee: 0,
        finalAmount: topupAmount,
        badgeText: '시연용 가상 충전',
        onConfirm: () => {
          setWalletBalance((b) => b + topupAmount);
          setConfirmModal((prev) => ({ ...prev, isOpen: false }));
          showToast('모의 충전 10,000원이 완료되었습니다!');
        },
      });
    };

    return (
      <div className="px-4 sm:px-6 pt-3 pb-8 space-y-4">
        <div className="flex items-center justify-between">
          <h1 className="text-2xl font-extrabold text-[#141812]">MY 올이</h1>
          <span className="text-xs font-bold px-3 py-1 rounded-full bg-amber-100 text-amber-900">
            같은 브라우저 내 시연 모드
          </span>
        </div>

        {/* 시연 프로필 카드 (실제 개인정보 미수집) */}
        <div className="bg-white rounded-3xl p-5 shadow-2xs border border-black/5 space-y-3.5">
          <div className="flex items-center justify-between">
            <div>
              <div className="text-xs text-[#4A5246]">온디바이스 암호화 토큰 프로필 (시연)</div>
              <div className="text-base font-extrabold text-[#141812] mt-0.5">
                범어동 이웃 #ALLE-0941
              </div>
            </div>
            <div className="text-right">
              <div className="text-xs text-[#4A5246]">시연 페이 잔액</div>
              <div className="text-xl font-extrabold text-[#2E531A]">
                {formatKRW(walletBalance)}
              </div>
            </div>
          </div>

          <div className="grid grid-cols-2 gap-2.5 pt-1">
            <button
              onClick={handleMockTopup}
              className="py-3 rounded-xl bg-[#2E531A] text-white font-extrabold text-[13px]"
            >
              + 10,000원 모의 충전
            </button>
            <button
              onClick={() => handleShareDemo('올이 O2O 단골 멤버십')}
              className="py-3 rounded-xl bg-[#E7EFE1] text-[#2E531A] font-extrabold text-[13px]"
            >
              시연 상태 공유 복사
            </button>
          </div>
        </div>

        {/* 같은 브라우저 역할 전환 스위처 */}
        <div className="bg-white rounded-3xl p-5 shadow-2xs border border-black/5 space-y-3.5">
          <div className="flex items-center justify-between">
            <h2 className="font-extrabold text-[15px] text-[#141812]">
              역할 전환 시연 (같은 브라우저)
            </h2>
            <span className="text-xs text-[#4A5246]">상단 바에서도 전환 가능</span>
          </div>

          <div className="grid grid-cols-3 gap-2 bg-[#F3F5F0] p-1.5 rounded-2xl">
            {[
              { id: 'customer' as RoleType, label: '고객 앱' },
              { id: 'merchant' as RoleType, label: '점주 모드' },
              { id: 'partner' as RoleType, label: '이웃/라이더' },
            ].map((r) => (
              <button
                key={r.id}
                onClick={() => {
                  setRole(r.id);
                  showToast(`'${r.label}' 화면으로 전환했습니다.`);
                }}
                className={`py-2.5 rounded-xl text-[13px] font-extrabold transition ${
                  role === r.id
                    ? 'bg-[#2E531A] text-white shadow-2xs'
                    : 'text-[#4A5246] hover:text-[#141812]'
                }`}
              >
                {r.label}
              </button>
            ))}
          </div>

          {/* 보유 쿠폰 안내 */}
          <div className="space-y-2 pt-1">
            <div className="text-[13px] font-bold text-[#141812]">
              보유 O2O 통합 단골 쿠폰 (상품합계 초과 자동방지 적용)
            </div>
            {coupons.map((cp) => (
              <div
                key={cp.id}
                className="p-3.5 rounded-2xl bg-[#F6F9F2] border border-[#D4E2C8] flex items-center justify-between"
              >
                <div>
                  <div className="text-sm font-extrabold text-[#141812]">{cp.title}</div>
                  <div className="text-xs text-[#4A5246] mt-0.5">
                    {cp.source} · {formatKRW(cp.minOrderAmount)} 이상 주문 시 자동적용
                  </div>
                </div>
                <span className="font-extrabold text-[15px] text-[#2E531A]">
                  -{formatKRW(cp.discountAmount)}
                </span>
              </div>
            ))}
          </div>

          {role === 'partner' && (
            <div className="space-y-2.5 pt-1">
              <div className="p-3.5 rounded-2xl bg-[#F4F8EF] border border-[#DCE8CF] space-y-1">
                <div className="text-[13px] font-extrabold text-[#2E531A]">
                  🚶 하이브리드 물류 Track 1 (이웃 도보 · 반경 1.2km)
                </div>
                <p className="text-xs text-[#4A5246]">
                  자택 동선 지오펜싱 마스킹 보호중 · 픽업~도착 20m 구간만 가상 아바타 표시
                </p>
              </div>
              <div className="p-3.5 rounded-2xl bg-[#F6F7F4] flex items-center justify-between">
                <div>
                  <div className="text-[13px] font-bold text-[#141812]">
                    진배기 사골국밥 → 범어동 302동 (650m 도보)
                  </div>
                  <div className="text-xs text-[#4A5246]">예상 보수 2,000원 · 소요 9분</div>
                </div>
                <button
                  onClick={() =>
