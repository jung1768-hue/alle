                  <Mic className="w-4 h-4" />
                  <span>주방 핸즈프리 음성 조작 시연</span>
                </div>
                <span className="text-xs font-bold text-[#2E531A]">온디바이스 NPU</span>
              </div>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <button
                  onClick={() => {
                    setOrders((prev) =>
                      prev.map((o, idx) => (idx === 0 ? { ...o, statusStep: 3 } : o))
                    );
                    setMerchantVoiceLog((prev) => [
                      '🎙️ "주문 수락, 조리 20분" → 픽업 완료 단계로 즉시 갱신 및 고객 ETA 알림 전송',
                      ...prev,
                    ]);
                    showToast('음성 명령으로 주문 단계가 업데이트되었습니다.');
                  }}
                  className="py-3 px-4 rounded-2xl bg-[#2E531A] text-white text-[13px] font-extrabold text-left flex items-center justify-between"
                >
                  <span>“주문 수락, 조리 20분”</span>
                  <span className="text-xs bg-white/20 px-2 py-0.5 rounded-full">실행</span>
                </button>
                <button
                  onClick={() => {
                    setOrders((prev) =>
                      prev.map((o, idx) =>
                        idx === 0 ? { ...o, deliveryMode: '전문 라이더 (Track 2)' } : o
                      )
                    );
                    setMerchantVoiceLog((prev) => [
                      '🛵 피크타임 즉시 전환: 일반 이웃 도보 → 전문 배달대행사(Track 2) 자동 배차 완료',
                      ...prev,
                    ]);
                    showToast('전문 라이더(Track 2) 호출로 즉시 전환되었습니다.');
                  }}
                  className="py-3 px-4 rounded-2xl bg-white text-[#2E531A] border border-[#2E531A]/30 text-[13px] font-extrabold text-left flex items-center justify-between"
                >
                  <span>“전문 라이더 즉시 전환”</span>
                  <span className="text-xs bg-[#E7EFE1] px-2 py-0.5 rounded-full">실행</span>
                </button>
              </div>
              <div className="space-y-1.5 pt-1">
                {merchantVoiceLog.slice(0, 3).map((log, i) => (
                  <div
                    key={i}
                    className="text-xs bg-white/90 px-3.5 py-2.5 rounded-xl text-[#141812] font-medium"
                  >
                    {log}
                  </div>
                ))}
              </div>
            </div>

            {/* 실시간 접수 주문 목록 */}
            <div className="space-y-2.5">
              <h2 className="font-extrabold text-base text-[#141812]">실시간 매장 접수 내역</h2>
              {orders.slice(0, 3).map((ord) => (
                <div
                  key={ord.id}
                  className="bg-white rounded-2xl p-4 border border-black/5 shadow-2xs flex items-center justify-between gap-3"
                >
                  <div>
                    <div className="flex items-center gap-2">
                      <span className="text-xs font-extrabold text-[#2E531A] bg-[#E7EFE1] px-2.5 py-0.5 rounded-full">
                        {ord.deliveryMode}
                      </span>
                      <span className="text-xs text-[#4A5246]">{ord.timeStr}</span>
                    </div>
                    <div className="font-extrabold text-[15px] text-[#141812] mt-1">
                      {ord.menuName} × {ord.quantity}개
                    </div>
                    <div className="text-xs text-[#4A5246] mt-0.5">
                      정산 예정액 {formatKRW(ord.itemsSubtotal)} (중개수수료 0원)
                    </div>
                  </div>
                  <button
                    onClick={() => {
                      setOrders((prev) =>
                        prev.map((item) =>
                          item.id === ord.id
                            ? {
                                ...item,
                                statusStep: ((item.statusStep % 4) + 1) as 1 | 2 | 3 | 4,
                              }
                            : item
                        )
                      );
                      showToast('조리·배달 단계가 다음으로 전환되었습니다.');
                    }}
                    className="px-3.5 py-2.5 rounded-xl bg-[#2E531A] text-white text-xs font-extrabold shrink-0"
                  >
                    단계 {ord.statusStep}/4 진행
                  </button>
                </div>
              ))}
            </div>
          </div>
        )}

        {merchantTab === 'menus' && (
          <div className="space-y-4">
            <button
              onClick={handleAddScannedMenu}
              className="w-full py-4 rounded-2xl bg-[#2E531A] hover:bg-[#234113] text-white font-extrabold text-[15px] flex items-center justify-center gap-2 shadow-sm transition"
            >
              <Camera className="w-5 h-5" />
              <span>종이 메뉴판 1초 VLM 스캔 신메뉴 등록 (시연)</span>
            </button>

            <div className="space-y-2.5">
              <div className="text-xs font-bold text-[#4A5246]">
                품절 토글 시 고객 앱의 ‘지금 바로 주문 가능한 맛집’ 필터에 즉시 반영됩니다.
              </div>
              {menus.map((m) => (
                <div
                  key={m.id}
                  className="bg-white rounded-2xl p-3.5 border border-black/5 flex items-center justify-between gap-3"
                >
                  <div>
                    <div className="font-extrabold text-[15px] text-[#141812]">{m.name}</div>
                    <div className="text-xs text-[#4A5246] mt-0.5">
                      {m.storeName} · 단일가 {formatKRW(m.price)}
                    </div>
                  </div>
                  <button
                    onClick={() => toggleMenuAvailability(m.id)}
                    className={`px-3.5 py-2 rounded-xl text-xs font-extrabold transition ${
                      m.isAvailableNow
                        ? 'bg-[#E7EFE1] text-[#2E531A]'
                        : 'bg-red-100 text-red-700'
                    }`}
                  >
                    {m.isAvailableNow ? '판매중 (주문가능)' : '당일 품절'}
                  </button>
                </div>
              ))}
            </div>
          </div>
        )}

        {merchantTab === 'reviews' && (
          <div className="space-y-3">
            {/* 악성 리뷰 AI 방어 세이프가드 */}
            <div className="bg-white rounded-2xl p-4 border border-black/5 space-y-2.5">
              <div className="flex items-center justify-between">
                <span className="text-xs font-extrabold text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full">
                  악성 별점 테러 AI 문맥 탐지
                </span>
                <span className="text-xs text-[#4A5246]">시연 케이스 #1</span>
              </div>
              <p className="text-sm text-[#141812] font-medium">
                “이유 없이 별 1개 남깁니다. 경쟁 가게가 더 낫네요.”
              </p>
              {maliciousBlocked ? (
                <div className="p-3 rounded-xl bg-emerald-50 text-xs font-bold text-emerald-900">
                  ✅ AI 세이프가드 블라인드 처리 완료 (매장 평점 보호 적용됨)
                </div>
              ) : (
                <button
                  onClick={() => {
                    setMaliciousBlocked(true);
                    showToast('허위·악성 리뷰가 AI 세이프가드로 차단되었습니다.');
                  }}
                  className="px-3.5 py-2 rounded-xl bg-[#2E531A] text-white text-xs font-extrabold"
                >
                  AI 세이프가드 차단 실행
                </button>
              )}
            </div>

            {/* 일반 긍정 리뷰 AI 맞춤 답글 */}
            <div className="bg-white rounded-2xl p-4 border border-black/5 space-y-2.5">
              <div className="flex items-center justify-between">
                <span className="text-xs font-extrabold text-[#2E531A] bg-[#E7EFE1] px-2.5 py-0.5 rounded-full">
                  ★ 5.0 단골 고객 리뷰
                </span>
                <span className="text-xs text-[#4A5246]">수성갈비탕 주문</span>
              </div>
              <p className="text-sm text-[#141812] font-medium">
                “갈빗대가 정말 실하고 국물이 진해서 부모님이 너무 좋아하셨어요!”
              </p>
              {reviewReplySent ? (
                <div className="p-3 rounded-xl bg-[#F6F9F2] border border-[#D4E2C8] text-xs text-[#141812] leading-relaxed">
                  <strong>점주 AI 자동 답글 등록됨:</strong> “소중한 부모님 식사에 저희 진배기 사골국밥을 찾아주셔서 진심으로 감사합니다! 다음에도 정성껏 푹 고아 따뜻하게 보내드리겠습니다 😊”
                </div>
              ) : (
                <button
                  onClick={() => {
                    setReviewReplySent(true);
                    showToast('점주 어투 맞춤 AI 답글이 등록되었습니다.');
                  }}
                  className="px-3.5 py-2 rounded-xl bg-[#E7EFE1] text-[#2E531A] text-xs font-extrabold"
                >
                  점주 어투 AI 맞춤 답글 자동 등록
                </button>
              )}
            </div>
          </div>
        )}
      </div>
    );
  };

  // ============================================================================
  // 8. 전체 레이아웃 조립 (모바일 390px ~ PC 화면 크기에 꽉 맞게 자동 적응)
  // ============================================================================

  return (
    <div className="min-h-[100dvh] bg-[#ECEEE8] text-[#141812] flex justify-center font-sans antialiased">
      {/* 반응형 앱 컨테이너: 모바일 390px에서 전체 너비, 태블릿/PC에서는 읽기 편한 중앙 반응형 앱 레이아웃 */}
      <main className="w-full max-w-md md:max-w-2xl lg:max-w-3xl min-h-[100dvh] bg-[#F6F7F4] shadow-sm flex flex-col relative">
        {/* 상단 시연 & 역할 전환 유틸리티 바 (고객 모드 / 점주 모드 / 파트너 모드 즉시 전환) */}
        <header className="sticky top-0 z-30 bg-[#141812] text-white px-3.5 py-2 flex items-center justify-between gap-2 text-xs shrink-0">
          <div className="flex items-center gap-1.5 min-w-0">
            <span className="w-2 h-2 rounded-full bg-[#8BC34A] shrink-0" />
            <span className="truncate font-semibold">
              {storageAvailable
                ? '시연 자료 모드'
                : '저장 불가 환경 · 메모리 모드로 시연 계속'}
            </span>
          </div>

          <div className="flex items-center gap-1.5 shrink-0">
            {/* 고객 / 점주 / 파트너 빠른 모드 스위처 */}
            <div className="flex items-center bg-white/10 rounded-full p-0.5">
              {(
                [
                  { id: 'customer', label: '고객' },
                  { id: 'merchant', label: '점주' },
                  { id: 'partner', label: '파트너' },
                ] as { id: RoleType; label: string }[]
              ).map((item) => (
                <button
                  key={item.id}
                  onClick={() => {
                    setRole(item.id);
                    setSubView({ type: 'none' });
                    if (item.id === 'partner') setActiveTab('my');
                    showToast(`'${item.label} 모드'로 전환되었습니다.`);
                  }}
                  className={`px-2.5 py-0.5 rounded-full text-[11px] font-extrabold transition ${
                    role === item.id
                      ? 'bg-[#8BC34A] text-[#141812]'
                      : 'text-white/80 hover:text-white'
                  }`}
                >
                  {item.label}
                </button>
              ))}
            </div>

            <button
              onClick={handleResetDemo}
              className="flex items-center gap-1 bg-white/15 hover:bg-white/25 px-2.5 py-1 rounded-full text-[11px] font-bold transition"
            >
              <RotateCcw className="w-3 h-3" />
              <span>데모 초기화</span>
            </button>
          </div>
        </header>

        {/* 본문 영역 */}
        <div className="flex-1 overflow-y-auto">
          {role === 'merchant' ? (
            renderMerchantFullView()
          ) : (
            <>
              {subView.type === 'ai_chat' && renderAiChatView()}
              {subView.type === 'menu_detail' &&
                renderMenuDetailView(subView.menuId, subView.isGroupBuy, subView.groupBuyId)}
              {subView.type === 'group_buy' && renderGroupBuyView()}
              {subView.type === 'delivery_match' && renderDeliveryMatchView()}
              {subView.type === 'errands' && renderErrandsView()}

              {subView.type === 'none' && (
                <>
                  {activeTab === 'home' && renderHomeTab()}
                  {activeTab === 'search' && renderSearchTab()}
                  {activeTab === 'orders' && renderOrdersTab()}
                  {activeTab === 'wishlist' && renderWishlistTab()}
                  {activeTab === 'my' && renderMyTab()}
                </>
              )}
            </>
          )}
        </div>

        {/* 하단 5개 탭 네비게이션 바 (고객/파트너 모드일 때 표시) */}
        {role !== 'merchant' && subView.type === 'none' && (
          <nav className="sticky bottom-0 z-20 bg-white/95 backdrop-blur border-t border-black/10 px-2 py-2 grid grid-cols-5 shrink-0">
            {[
              { id: 'home' as MainTab, label: '홈', icon: Home },
              { id: 'search' as MainTab, label: '검색', icon: Search },
              { id: 'orders' as MainTab, label: '주문내역', icon: ClipboardList },
              { id: 'wishlist' as MainTab, label: '찜', icon: Heart },
              { id: 'my' as MainTab, label: 'MY', icon: User },
            ].map((tab) => {
              const IconComp = tab.icon;
              const isActive = activeTab === tab.id;
              return (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  className="flex flex-col items-center justify-center py-1 gap-1"
                >
                  <div
                    className={`p-1 rounded-xl transition ${
                      isActive ? 'text-[#2E531A]' : 'text-[#5A6256]'
                    }`}
                  >
                    <IconComp
                      className={`w-5 h-5 ${isActive ? 'stroke-[2.5px]' : 'stroke-[1.9px]'}`}
                    />
                  </div>
                  <span
                    className={`text-xs font-extrabold ${
                      isActive ? 'text-[#2E531A]' : 'text-[#5A6256]'
                    }`}
                  >
                    {tab.label}
                  </span>
                </button>
              );
            })}
          </nav>
        )}

        {/* 주문/예약/충전 최종 확인 모달 (마지막 확인 후에만 모의 처리) */}
        {confirmModal.isOpen && (
          <div className="fixed inset-0 bg-black/55 backdrop-blur-2xs flex items-end sm:items-center justify-center z-40 p-3">
            <div className="w-full max-w-md bg-white rounded-3xl p-5 sm:p-6 shadow-2xl space-y-4">
              <div className="flex items-start justify-between">
                <div>
                  <span className="text-xs font-extrabold text-[#2E531A] bg-[#E7EFE1] px-3 py-1 rounded-full">
                    {confirmModal.badgeText || '최종 확인 · 모의 결제'}
                  </span>
                  <h3 className="text-xl font-extrabold text-[#141812] mt-2">
                    {confirmModal.title}
                  </h3>
                  <p className="text-[13px] text-[#4A5246] mt-0.5">{confirmModal.subtitle}</p>
                </div>
                <button
                  onClick={() => setConfirmModal((prev) => ({ ...prev, isOpen: false }))}
                  className="p-1.5 rounded-full hover:bg-gray-100"
                >
                  <X className="w-5 h-5 text-gray-500" />
                </button>
              </div>

              <div className="bg-[#F6F7F4] rounded-2xl p-4 space-y-2.5 text-sm">
                <div className="flex justify-between text-[#4A5246]">
                  <span>상품 합계</span>
                  <span className="font-bold text-[#141812]">
                    {formatKRW(confirmModal.itemsSubtotal)}
                  </span>
                </div>
                {confirmModal.couponDiscount > 0 && (
                  <div className="flex justify-between text-[#2E531A]">
                    <span>AI 자동최적 쿠폰 ({confirmModal.couponTitle})</span>
                    <span className="font-extrabold">
                      -{formatKRW(confirmModal.couponDiscount)}
                    </span>
                  </div>
                )}
                <div className="flex justify-between text-[#4A5246]">
                  <span>배달비 (하이브리드 매칭)</span>
                  <span className="font-bold text-[#141812]">
                    +{formatKRW(confirmModal.deliveryFee)}
                  </span>
                </div>
                <div className="flex justify-between pt-2.5 border-t border-gray-200 text-base font-extrabold text-[#141812]">
                  <span>최종 모의 결제금액</span>
                  <span className="text-[#2E531A] text-lg">
                    {formatKRW(confirmModal.finalAmount)}
                  </span>
                </div>
              </div>

              <p className="text-xs text-[#4A5246] text-center">
                ※ 시연용 가상 처리이며 실제 카드 청구·외부 결제가 발생하지 않습니다.
              </p>

              <div className="grid grid-cols-2 gap-2.5">
                <button
                  onClick={() => setConfirmModal((prev) => ({ ...prev, isOpen: false }))}
                  className="py-3.5 rounded-2xl bg-gray-100 text-[#141812] font-extrabold text-sm"
                >
                  취소
                </button>
                <button
                  onClick={confirmModal.onConfirm}
                  className="py-3.5 rounded-2xl bg-[#2E531A] hover:bg-[#234113] text-white font-extrabold text-sm shadow-md"
                >
                  최종 확인 및 모의 처리
                </button>
              </div>
            </div>
          </div>
        )}

        {/* 토스트 알림 배너 */}
        {toastMsg && (
          <div className="fixed top-12 left-1/2 -translate-x-1/2 w-[92%] max-w-md z-50 bg-[#141812]/95 text-white text-[13px] font-bold px-4 py-3.5 rounded-2xl shadow-lg flex items-center gap-2.5">
            <CheckCircle2 className="w-4 h-4 text-[#8BC34A] shrink-0" />
            <span>{toastMsg}</span>
          </div>
        )}
      </main>
    </div>
  );
}

export default App;