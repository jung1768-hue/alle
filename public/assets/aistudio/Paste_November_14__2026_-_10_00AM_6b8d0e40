                  className="px-3.5 py-2 rounded-xl bg-[#2E531A] text-white text-xs font-extrabold"
                >
                  콜 수락
                </button>
              </div>
            </div>
          )}
        </div>
      </div>
    );
  };

  // [전용 전체 화면] 점주 AI 포스 & 매장 운영 모드 (제안서 §2, §4, §8 반영)
  const renderMerchantFullView = () => {
    const handleAddScannedMenu = () => {
      const exists = menus.some((m) => m.id === 'menu-tteokguk');
