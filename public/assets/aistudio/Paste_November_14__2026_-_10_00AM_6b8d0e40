      <div className="px-4 sm:px-6 pt-3 pb-8 space-y-5">
        {/* 점주 상단 헤더 */}
        <div className="bg-white rounded-3xl p-4 sm:p-5 border border-black/5 shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <div className="flex items-center gap-2">
              <span className="text-xs font-extrabold px-2.5 py-0.5 rounded-full bg-[#E7EFE1] text-[#2E531A]">
                점주 AI 포스 모드 (시연)
              </span>
              <span className="text-xs font-bold text-[#4A5246]">중개수수료 0%</span>
            </div>
            <h1 className="text-xl font-extrabold text-[#141812] mt-1.5">
              진배기 사골국밥 · 범어본점
            </h1>
          </div>

          <button
            onClick={() => setRole('customer')}
            className="self-start sm:self-auto px-4 py-2.5 rounded-xl bg-[#2E531A] text-white text-xs font-extrabold shadow-2xs"
          >
            고객 화면으로 돌아가기
          </button>
        </div>

        {/* 주방 혼잡도 & 오늘 매출 요약 KPI */}
        <div className="grid grid-cols-3 gap-2.5">
          <div className="bg-white rounded-2xl p-3.5 border border-black/5">
            <div className="text-xs text-[#4A5246]">오늘 시연 매출</div>
            <div className="text-base sm:text-lg font-extrabold text-[#141812] mt-1">
              482,000원
            </div>
            <div className="text-[11px] font-bold text-[#2E531A] mt-0.5">수수료 0원 절감</div>
          </div>
          <div className="bg-white rounded-2xl p-3.5 border border-black/5">
            <div className="text-xs text-[#4A5246]">AI 주방 혼잡도</div>
            <div className="text-base sm:text-lg font-extrabold text-[#2E531A] mt-1">원활 (18분)</div>
            <div className="text-[11px] text-[#4A5246] mt-0.5">조리시간 자동추천</div>
          </div>
          <div className="bg-white rounded-2xl p-3.5 border border-black/5">
            <div className="text-xs text-[#4A5246]">단골 O2O 스탬프</div>
            <div className="text-base sm:text-lg font-extrabold text-[#141812] mt-1">148명</div>
            <div className="text-[11px] text-[#4A5246] mt-0.5">재주문율 64%</div>
          </div>
        </div>

        {/* 점주 서브 탭 */}
        <div className="grid grid-cols-3 bg-[#E9ECE4] p-1 rounded-2xl">
          {[
            { id: 'orders' as const, label: '실시간 주문·음성' },
            { id: 'menus' as const, label: '메뉴·품절·스캔' },
            { id: 'reviews' as const, label: 'AI 리뷰 세이프가드' },
          ].map((t) => (
            <button
              key={t.id}
              onClick={() => setMerchantTab(t.id)}
              className={`py-2.5 rounded-xl text-[13px] font-extrabold transition ${
                merchantTab === t.id ? 'bg-white text-[#2E531A] shadow-2xs' : 'text-[#4A5246]'
              }`}
            >
              {t.label}
            </button>
          ))}
        </div>

        {merchantTab === 'orders' && (
          <div className="space-y-4">
            {/* 핸즈프리 음성 조작 패널 */}
            <div className="bg-[#E7EFE1] rounded-3xl p-4 sm:p-5 border border-[#C7D9B8] space-y-3">
