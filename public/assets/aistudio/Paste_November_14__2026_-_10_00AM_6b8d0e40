  const [storageAvailable] = useState<boolean>(() => checkStorageAvailable());

  // 초기 상태 로드 (localStorage -> 실패 시 내장 JSON 기본값)
  const loadInitialState = () => {
    if (storageAvailable) {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        if (raw) {
          return JSON.parse(raw);
        }
      } catch {
        // 메모리 모드로 계속 진행
      }
    }
    return null;
  };

  const saved = useMemo(() => loadInitialState(), []);

  // 핵심 애플리케이션 상태
  const [role, setRole] = useState<RoleType>(saved?.role || 'customer');
  const [activeTab, setActiveTab] = useState<MainTab>('home');
  const [subView, setSubView] = useState<SubView>({ type: 'none' });
  const [neighborhood, setNeighborhood] = useState<string>(
    saved?.neighborhood || '대구 수성구 범어동'
  );
  const [showLocationPicker, setShowLocationPicker] = useState(false);

  const [menus, setMenus] = useState<MenuItem[]>(saved?.menus || INITIAL_MENUS);
  const [groupBuys, setGroupBuys] = useState<GroupBuyDeal[]>(
    saved?.groupBuys || INITIAL_GROUP_BUYS
  );
  const [coupons, setCoupons] = useState<CouponItem[]>(saved?.coupons || INITIAL_COUPONS);
  const [orders, setOrders] = useState<OrderRecord[]>(saved?.orders || INITIAL_ORDERS);
  const [wishlistIds, setWishlistIds] = useState<string[]>(
    saved?.wishlistIds || ['menu-galbitang', 'menu-chicken']
  );
  const [walletBalance, setWalletBalance] = useState<number>(saved?.walletBalance ?? 35000);
  const [errands, setErrands] = useState<ErrandTask[]>(saved?.errands || INITIAL_ERRANDS);

  // 주문내역 서브탭 & 달력 상태
  const [ordersSubTab, setOrdersSubTab] = useState<'status' | 'history'>('history');
  const [calendarMode, setCalendarMode] = useState<'monthly' | 'yearly'>('monthly');
  const [selectedMonth, setSelectedMonth] = useState<number>(2); // 2월 (첨부 이미지 동일)
  const [selectedDateStr, setSelectedDateStr] = useState<string>('2026-02-22');

  // 검색 화면 상태
  const [searchQuery, setSearchQuery] = useState<string>('');
  const [onlyAvailableNow, setOnlyAvailableNow] = useState<boolean>(true);
  const [selectedCategory, setSelectedCategory] = useState<string>('전체');

  // AI 주문하기 채팅 상태
  const [voiceMode, setVoiceMode] = useState<boolean>(true);
  const [chatInput, setChatInput] = useState<string>('');
  const [chatMessages, setChatMessages] = useState<ChatMessage[]>([
    {
      id: 'msg-welcome',
      sender: 'ai',
      text: '안녕하세요!\n뭐 드시고 싶으세요?\n말로 하시거나, 아래에서 선택해도 돼요.',
    },
    {
      id: 'msg-user-init',
      sender: 'user',
      text: '따뜻한 국물 있는 한식 먹고 싶어요',
    },
    {
      id: 'msg-ai-rec',
      sender: 'ai',
      text: '따뜻한 국물 요리로 이 근처의 인기 메뉴를 추천해드릴게요! 😊',
      recommendedMenuIds: ['menu-galbitang', 'menu-kimchi-stew', 'menu-sundubu'],
      quickOrderMenuId: 'menu-galbitang',
      quickOrderQty: 1,
    },
  ]);

  // 메뉴 상세 화면 상태
  const [detailOptionId, setDetailOptionId] = useState<string>('');
  const [detailAddonIds, setDetailAddonIds] = useState<string[]>([]);
  const [detailQty, setDetailQty] = useState<number>(1);
  const [detailReservationSlot, setDetailReservationSlot] = useState<string>('즉시 배달 (약 28분)');

  // 공동구매 탭 상태
  const [gbTab, setGbTab] = useState<'ongoing' | 'upcoming'>('ongoing');

  // 심부름 입력 상태
  const [errandPrompt, setErrandPrompt] = useState<string>('');

  // 점주 음성 명령 / 로그 상태
  const [merchantVoiceLog, setMerchantVoiceLog] = useState<string[]>([
    'AI 주방 도우미 대기중 — "주문 수락, 20분" 또는 "치즈볼 품절"을 눌러 시연해보세요.',
  ]);
  const [merchantTab, setMerchantTab] = useState<'orders' | 'menus' | 'reviews'>('orders');
  const [reviewReplySent, setReviewReplySent] = useState<boolean>(false);
  const [maliciousBlocked, setMaliciousBlocked] = useState<boolean>(false);

  // 토스트 알림 & 최종 확인 모달
  const [toastMsg, setToastMsg] = useState<string | null>(null);
  const [confirmModal, setConfirmModal] = useState<ConfirmModalState>({
    isOpen: false,
    title: '',
    subtitle: '',
    itemsSubtotal: 0,
    couponDiscount: 0,
    deliveryFee: 0,
    finalAmount: 0,
    onConfirm: () => {},
  });

  // 상태 변경 시 localStorage 자동 저장
  useEffect(() => {
    if (!storageAvailable) return;
    try {
      const payload = {
        role,
        neighborhood,
        menus,
        groupBuys,
        coupons,
        orders,
        wishlistIds,
        walletBalance,
        errands,
      };
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
    } catch {
      // 저장 실패 시 무시하고 메모리 상태 유지
    }
  }, [
    storageAvailable,
    role,
    neighborhood,
    menus,
    groupBuys,
    coupons,
    orders,
    wishlistIds,
    walletBalance,
    errands,
  ]);

  const showToast = (msg: string) => {
    setToastMsg(msg);
    window.setTimeout(() => {
      setToastMsg((prev) => (prev === msg ? null : prev));
    }, 3000);
  };

  // 데모 초기화 핸들러
  const handleResetDemo = () => {
    if (storageAvailable) {
      try {
        window.localStorage.removeItem(STORAGE_KEY);
      } catch {
        // ignore
      }
    }
    setRole('customer');
    setActiveTab('home');
    setSubView({ type: 'none' });
    setNeighborhood('대구 수성구 범어동');
    setMenus(INITIAL_MENUS);
    setGroupBuys(INITIAL_GROUP_BUYS);
    setCoupons(INITIAL_COUPONS);
    setOrders(INITIAL_ORDERS);
    setWishlistIds(['menu-galbitang', 'menu-chicken']);
    setWalletBalance(35000);
    setErrands(INITIAL_ERRANDS);
    setOrdersSubTab('history');
    setSelectedMonth(2);
    setSelectedDateStr('2026-02-22');
    showToast('시연 데이터가 초기 상태로 리셋되었습니다.');
  };

  // 찜 토글
  const toggleWishlist = (menuId: string) => {
    setWishlistIds((prev) => {
      const exists = prev.includes(menuId);
      const next = exists ? prev.filter((id) => id !== menuId) : [...prev, menuId];
      showToast(exists ? '찜 목록에서 해제했어요.' : '찜 목록에 담았어요! 💚');
      return next;
    });
  };

  // 메뉴 상세 화면 열기
  const openMenuDetail = (menuId: string, isGroupBuy = false, groupBuyId?: string) => {
    const target = menus.find((m) => m.id === menuId) || menus[0];
    setDetailOptionId(target.options[0]?.id || '');
    setDetailAddonIds([]);
    setDetailQty(1);
    setDetailReservationSlot(`즉시 배달 (약 ${target.deliveryMinutes}분)`);
    setSubView({ type: 'menu_detail', menuId: target.id, isGroupBuy, groupBuyId });
  };

  // 주문/예약 최종 확인 모달 열기 -> 확인 후에만 모의 주문 생성
  const triggerOrderConfirmation = (params: {
    menu: MenuItem;
    optionName: string;
    unitPrice: number;
    quantity: number;
    deliveryFee: number;
    deliveryMode: OrderRecord['deliveryMode'];
    reservationTime?: string;
    groupBuyId?: string;
  }) => {
    const safeQty = sanitizeQuantity(params.quantity);
    const safeUnit = Math.max(0, Math.round(params.unitPrice));
    const itemsSubtotal = safeUnit * safeQty;
    const { coupon, appliedDiscount } = calculateBestCoupon(itemsSubtotal, coupons);
    const safeDeliveryFee = Math.max(0, Math.round(params.deliveryFee));
    const finalAmount = Math.max(0, itemsSubtotal - appliedDiscount + safeDeliveryFee);

    setConfirmModal({
      isOpen: true,
      title: `${params.menu.name} (${safeQty}개)`,
      subtitle: `${params.menu.storeName} · ${params.optionName}${
        params.reservationTime ? ` · 예약: ${params.reservationTime}` : ''
      }`,
      itemsSubtotal,
      couponTitle: coupon?.title,
      couponDiscount: appliedDiscount,
      deliveryFee: safeDeliveryFee,
      finalAmount,
      badgeText: params.deliveryMode,
      onConfirm: () => {
        const newOrder: OrderRecord = {
          id: `ord-${Date.now()}`,
          dateStr: '2026-02-22',
          timeStr: '09:41',
          storeName: params.menu.storeName,
          menuId: params.menu.id,
          menuName: params.menu.name,
          optionName: params.optionName,
          quantity: safeQty,
          itemsSubtotal,
          discountApplied: appliedDiscount,
          deliveryFee: safeDeliveryFee,
          totalPaid: finalAmount,
          deliveryMode: params.deliveryMode,
          reservationTime: params.reservationTime,
          statusStep: 2, // 조리 중 상태로 실시간 관제 시작
          dishArt: params.menu.dishArt,
        };

        setOrders((prev) => [newOrder, ...prev]);
        setWalletBalance((prev) => Math.max(0, prev - finalAmount));

        // 한정 수량 차감
        setMenus((prev) =>
          prev.map((m) =>
            m.id === params.menu.id && typeof m.remainingLimited === 'number'
              ? { ...m, remainingLimited: Math.max(0, m.remainingLimited - safeQty) }
              : m
          )
        );

        // 공동구매 참여 수 증가
        if (params.groupBuyId) {
          setGroupBuys((prev) =>
            prev.map((g) =>
              g.id === params.groupBuyId
                ? {
                    ...g,
                    currentParticipants: Math.min(g.targetParticipants, g.currentParticipants + 1),
                  }
                : g
            )
          );
        }

        setConfirmModal((prev) => ({ ...prev, isOpen: false }));
        setSubView({ type: 'none' });
        setActiveTab('orders');
        setOrdersSubTab('status');
        showToast('모의 결제가 완료되어 실시간 라이브 관제를 시작합니다!');
      },
    });
  };

  // AI 채팅 메시지 전송 처리 (규칙 기반 추천)
  const handleSendChat = (customPrompt?: string) => {
    const text = (customPrompt ?? chatInput).trim();
    if (!text) return;

    const userMsg: ChatMessage = {
      id: `u-${Date.now()}`,
      sender: 'user',
      text,
    };

    const rec = runRuleBasedRecommender(text, menus);
    const aiMsg: ChatMessage = {
      id: `a-${Date.now() + 1}`,
      sender: 'ai',
      text: rec.replyText,
      recommendedMenuIds: rec.matchedMenus.map((m) => m.id),
      quickOrderMenuId: rec.quickOrderMenu.id,
      quickOrderQty: 1,
    };

    setChatMessages((prev) => [...prev, userMsg, aiMsg]);
    if (!customPrompt) setChatInput('');
  };

  // 브라우저 공유 시연
  const handleShareDemo = (label: string) => {
    const shareText = `[올이(Alle) 시연] ${label} - 같은 브라우저 내 시연 모드 링크가 복사되었습니다.`;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(shareText).catch(() => {});
    }
    showToast('같은 브라우저 시연 공유 안내가 복사되었습니다.');
  };

  // ============================================================================
  // 6. 서브 화면 렌더링 함수들
  // ============================================================================

  // (A) AI 주문하기 화면 (첨부 이미지 2번 디자인 정밀 반영)
  const renderAiChatView = () => {
    return (
      <div className="flex flex-col h-full bg-[#F6F7F4]">
        {/* 상단 헤더 */}
        <div className="flex items-center justify-between px-4 py-3.5 bg-white border-b border-black/5">
          <button
            onClick={() => setSubView({ type: 'none' })}
            className="p-2 -ml-2 rounded-full hover:bg-black/5 active:scale-95 transition"
            aria-label="뒤로가기"
          >
            <ChevronLeft className="w-6 h-6 text-[#141812]" />
          </button>
          <div className="flex items-center gap-2">
            <span className="inline-block w-5 h-3.5 rounded-b-full border-b-[3.5px] border-l-[3.5px] border-r-[3.5px] border-[#5D8C32]" />
            <span className="font-extrabold text-[19px] text-[#141812] tracking-tight">AI 주문하기</span>
          </div>
          <button
            onClick={() => {
              setVoiceMode((v) => !v);
              showToast(!voiceMode ? '음성모드가 켜졌습니다 (시연)' : '텍스트 입력 모드로 전환');
            }}
            className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold border transition ${
              voiceMode
                ? 'bg-[#E7EFE1] text-[#2E531A] border-[#C3D6B4]'
                : 'bg-white text-[#4A5246] border-gray-200'
            }`}
          >
            <Volume2 className="w-4 h-4" />
            음성모드
          </button>
        </div>

        {/* 규칙 기반 시연 안내 배지 */}
        <div className="px-4 py-2 bg-[#E7EFE1] text-xs font-medium text-[#2E531A] flex items-center justify-between">
          <span>온디바이스 규칙 기반 Zero-UI 추천 (Gemini 연동 후속 단계)</span>
          <span className="font-bold">시연 자료</span>
        </div>

        {/* 대화 스크롤 영역 */}
        <div className="flex-1 overflow-y-auto px-4 py-4 space-y-4">
          {chatMessages.map((msg, idx) => {
            if (msg.sender === 'user') {
              return (
                <div key={msg.id} className="flex justify-end">
                  <div className="bg-[#2E531A] text-white px-4 py-3 rounded-2xl rounded-br-sm text-[15px] font-semibold shadow-sm flex items-center gap-2 max-w-[85%]">
                    <span className="tracking-widest text-xs opacity-80">ılılı</span>
                    <span>{msg.text}</span>
                  </div>
                </div>
              );
            }

            const recMenus = (msg.recommendedMenuIds || [])
              .map((id) => menus.find((m) => m.id === id))
              .filter(Boolean) as MenuItem[];
            const quickMenu = msg.quickOrderMenuId
              ? menus.find((m) => m.id === msg.quickOrderMenuId)
              : undefined;
            const currentQty = sanitizeQuantity(msg.quickOrderQty || 1);

            return (
              <div key={msg.id} className="space-y-3">
                {/* 로봇 말풍선 */}
                <div className="flex items-start gap-2.5">
                  <AlleRobotMascot size="sm" />
                  <div className="bg-white px-4 py-3.5 rounded-2xl rounded-tl-sm shadow-sm border border-black/5 text-[15px] leading-relaxed text-[#141812] whitespace-pre-line">
                    {msg.text}
                  </div>
                </div>

                {/* 첫 인사말 아래 빠른 선택 칩 */}
                {idx === 0 && (
                  <div className="flex gap-2 overflow-x-auto pb-1 no-scrollbar">
                    {[
                      { label: '오늘 추천 메뉴', prompt: '따뜻한 국물 있는 한식 먹고 싶어요' },
                      { label: '빠른 재주문', prompt: '바삭치킨 2만 5천원 이하로 주문해줘' },
                      { label: '배달비 아끼기', prompt: '가성비 좋은 짜장면 추천해줘' },
                      { label: '예약 주문', prompt: '저녁에 먹을 얼큰한 순두부찌개 추천' },
                    ].map((chip) => (
                      <button
                        key={chip.label}
                        onClick={() => handleSendChat(chip.prompt)}
                        className="shrink-0 bg-white hover:bg-[#E7EFE1] text-[#141812] text-[13px] font-semibold px-4 py-2 rounded-full border border-black/10 shadow-2xs transition"
                      >
                        {chip.label}
                      </button>
                    ))}
                  </div>
                )}

                {/* 가로 추천 메뉴 카드 캐러셀 */}
                {recMenus.length > 0 && (
                  <div className="flex gap-3 overflow-x-auto pb-1 no-scrollbar">
                    {recMenus.map((item, rIdx) => {
                      const wished = wishlistIds.includes(item.id);
                      return (
                        <div
                          key={item.id}
