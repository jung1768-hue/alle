  addons: MenuAddon[];
}

interface GroupBuyDeal {
  id: string;
  menuId: string;
  storeName: string;
  menuName: string;
  originalPrice: number;
  groupPrice: number;
  discountPercent: number;
  currentParticipants: number;
  targetParticipants: number;
  remainingTimeText: string;
  status: 'ongoing' | 'upcoming';
  dishArt: MenuItem['dishArt'];
}

interface CouponItem {
  id: string;
  title: string;
  discountAmount: number;
  minOrderAmount: number;
  source: string;
}

interface OrderRecord {
  id: string;
  dateStr: string; // YYYY-MM-DD
  timeStr: string; // HH:mm
  storeName: string;
  menuId: string;
  menuName: string;
  optionName: string;
  quantity: number;
  itemsSubtotal: number;
  discountApplied: number;
  deliveryFee: number;
  totalPaid: number;
  deliveryMode: '이웃 도보 (Track 1)' | '전문 라이더 (Track 2)' | '공동구매 묶음';
  reservationTime?: string;
  statusStep: 1 | 2 | 3 | 4; // 1:주문접수, 2:조리중, 3:픽업완료, 4:배송완료
  dishArt: MenuItem['dishArt'];
  csResolved?: string;
}

interface ErrandTask {
  id: string;
  title: string;
  detail: string;
  itemDeposit: number;
  errandFee: number;
  status: '모집중' | '수행중' | '영수증검수완료';
  partnerName: string;
}

interface ChatMessage {
  id: string;
  sender: 'ai' | 'user';
  text: string;
  recommendedMenuIds?: string[];
  quickOrderMenuId?: string;
  quickOrderQty?: number;
}

interface ConfirmModalState {
  isOpen: boolean;
  title: string;
  subtitle: string;
  itemsSubtotal: number;
  couponTitle?: string;
  couponDiscount: number;
  deliveryFee: number;
  finalAmount: number;
  badgeText?: string;
  onConfirm: () => void;
}

