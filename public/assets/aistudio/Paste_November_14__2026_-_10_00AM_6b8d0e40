                <div className="text-xs text-gray-500">배달비 절약</div>
                <div className="text-sm font-extrabold text-[#486B28]">최대 3,000원</div>
              </div>
              <div className="bg-white rounded-2xl p-4 text-center border border-black/5 shadow-2xs space-y-1.5">
                <Leaf className="w-6 h-6 text-[#486B28] mx-auto" />
                <div className="text-xs text-gray-500">더 친환경적인 배달</div>
                <div className="text-sm font-extrabold text-[#486B28]">탄소 줄이기</div>
              </div>
            </div>
          </div>
        </div>

        <div className="p-4 bg-[#F7F7F5]">
          <button
            onClick={() => openMenuDetail('menu-chicken', true, 'gb-1')}
            className="w-full py-4 rounded-2xl bg-[#486B28] hover:bg-[#3A5720] text-white font-bold text-base shadow-md transition"
          >
