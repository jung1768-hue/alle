      const scannedItem: MenuItem = {
        id: 'menu-tteokguk',
        storeId: 'store-jinbaegi',
        storeName: '진배기 사골국밥',
        name: '한우 사골떡만둣국',
        category: '한식/국물',
        price: 11500,
        rating: 5.0,
        reviewCount: 1,
        deliveryMinutes: 25,
        deliveryFee: 1500,
        isAvailableNow: true,
        isSinglePriceGuaranteed: true,
        remainingLimited: 10,
        tags: ['국물', '따뜻한', '한식', '떡국', '신메뉴'],
        description: '점주 AI 포스 종이 메뉴판 1초 VLM 스캔으로 자동 등록된 단일가 메뉴 (시연 자료)',
        aiPros: ['매장 식사가와 100% 동일한 단일가격 보증 신메뉴'],
        aiCons: ['당일 한정 10그릇 준비'],
        dishArt: 'galbitang',
        options: [{ id: 'opt-tg-std', name: '한우 사골떡만둣국', price: 11500 }],
        addons: [{ id: 'add-rice-tg', name: '공기밥 추가', price: 1000 }],
      };
      setMenus((prev) => [scannedItem, ...prev]);
      setMerchantVoiceLog((prev) => [
        '📷 VLM 종이 메뉴판 1초 스캔: "한우 사골떡만둣국 (11,500원)" 고객 앱 즉시 노출 완료',
        ...prev,
      ]);
      showToast('종이 메뉴판 1초 스캔으로 고객 앱 메뉴에 즉시 등록되었습니다!');
    };

    const toggleMenuAvailability = (menuId: string) => {
      setMenus((prev) =>
        prev.map((m) => (m.id === menuId ? { ...m, isAvailableNow: !m.isAvailableNow } : m))
      );
      showToast('메뉴 실시간 주문 가능 상태가 고객 앱에 즉시 반영되었습니다.');
    };

